; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kebun Sawit Simulator"
config/description="Simulator kebun sawit — MVP offline. Lihat README.md."
run/main_scene="res://scenes/SplashVideo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_source_1024x1024.png"

[autoload]

Database="*res://autoload/Database.gd"
GameState="*res://autoload/GameState.gd"
TimeManager="*res://autoload/TimeManager.gd"
SoundManager="*res://autoload/SoundManager.gd"
PurchaseManager="*res://autoload/PurchaseManager.gd"
LeaderboardManager="*res://autoload/LeaderboardManager.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/modernist_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.953, 0.949, 0.949, 1)
textures/vram_compression/import_etc2_astc=true
