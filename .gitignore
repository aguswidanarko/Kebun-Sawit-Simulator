# Godot 4
.godot/
.import/
export.cfg

# export_presets.cfg di-track (bukan di-ignore) supaya setting "Export
# resources used in the project" & config Android ikut ter-share lewat repo.
# Jangan pernah isi keystore/release_password dsb langsung di file itu —
# pakai env var GODOT_ANDROID_KEYSTORE_RELEASE_USER/PASSWORD saat build.

# Android signing — JANGAN pernah commit keystore asli
*.keystore
*.jks
keystore.properties

# macOS / Windows
.DS_Store
Thumbs.db

# File kunci Microsoft Office. Muncul saat .rules/.md/.docx dibuka di Word —
# Word menamainya dengan mengganti 2 huruf pertama, mis. firestore.rules
# menghasilkan "~$restore.rules". Isinya nama pengguna, bukan data proyek.
~$*

# Build output
build/
*.apk
*.aab
